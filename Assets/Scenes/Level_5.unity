  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "1) If you\u2019re on a one-way street, in which direction can you legally
    drive?\n\n2) If you\u2019re facing west and turn clockwise 180 degrees, which
    direction are you facing now?\n\n3) In a race, which direction do you run if
    there\u2019s no need to change lanes?\n\n4) In chess, pawns only capture by moving
    diagonally in which direction when on the white side?\n\n5) I\u2019m the direction
    your brain controls when you move your left hand. What am I?\n\n6) I\u2019m the
    direction that leads to the hand used by the majority. What am I?\n\n7) I\u2019m
    the hand most people don\u2019t use to write. What am I?\n\n8) If you need to
    get to the end of a hallway without deviation, which direction will you walk?"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
