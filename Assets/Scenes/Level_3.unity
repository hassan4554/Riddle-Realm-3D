  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "1)   In a book, I\u2019m the side where page numbers start. What am I?\n\n2)
    I\u2019m the opposite of left, the opposite of wrong. What am I?\n\n3) I\u2019m
    the direction you turn at a clockwise intersection. What am I?\n\n4) I\u2019m
    the side of the road you drive on in the UK. What am I?\n\n5) I\u2019m the side
    of the road you drive on in the USA. What am I?\n\n6) I\u2019m the direction
    you continue in if you don\u2019t turn left or right. What am I?"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
